# Copy this file to `.env` and fill in real values for local development.
# Netlify holds the production values as deploy environment variables —
# this file is never read in production, only by `bun run dev`/`vite`.

# --- Supabase: browser client (public) ---
# Read client-side, so these get inlined into the browser bundle by Vite.
# Safe to expose: RLS policies are the actual access boundary, not secrecy
# of these values.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Supabase: server-only client (auth middleware, MCP tools) ---
# Same project as above, but read via process.env on the server only —
# never bundled to the client. See src/integrations/supabase/auth-middleware.ts.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Supabase: service-role client (bypasses RLS) ---
# SECRET. Only ever imported lazily inside server handlers
# (src/integrations/supabase/client.server.ts) — never at the top level of a
# route or *.functions.ts file, since those ship to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- Supabase project ref (MCP OAuth issuer) ---
# Just the project ref segment (the part before ".supabase.co"), used to
# build the OAuth issuer URL for the MCP server. See src/lib/mcp/index.ts.
VITE_SUPABASE_PROJECT_ID=your-project-ref

# --- Public site origin ---
# The site's canonical public URL (no trailing slash). Both fall back to
# https://ploiestiulistoricdigital.ro if unset, so these are optional in
# local dev. See src/lib/site-url.ts.
PUBLIC_SITE_URL=http://localhost:8080
VITE_PUBLIC_SITE_URL=http://localhost:8080

# --- Anthropic API (translation) ---
# SECRET. Powers translateText (src/lib/translate.functions.ts), which
# requires an authenticated admin — see plan.md / CODE_REVIEW.md SEC-1.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- Google Analytics ---
# Public GA4 Measurement ID. Falls back to the production ID hardcoded in
# src/lib/analytics.ts if unset, so this is optional in local dev. GA only
# loads in production builds, and only after the visitor accepts the cookie
# consent banner (see src/components/CookieConsentBanner.tsx).
VITE_GA_MEASUREMENT_ID=G-SLBE39ZM42
